generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Tune {
  id          String   @id @default(cuid())
  name        String
  carName     String
  piClass     String
  weight      Int
  frontDist   Float
  power       Int
  drivetrain  String
  trackType   String
  style       String
  parts       String
  results     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
